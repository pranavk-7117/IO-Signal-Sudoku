        },
        {
          "column": "external_power",
          "operator": "contains",
          "value": "110vac"
        },
        {
          "column": "electrical_spec",
          "operator": "contains",
          "value": "4wire"
        }
      ],
      "match_mode": "any",
      "hardware": {
        "charm_type": "AI 4-20 MA HART CHARM",
        "charm_part_no": "SE4303T01",
        "terminal_block": "Standard CHARM Terminal Block",
        "charm_tb_part_no": "SE4501",
        "charm_tb_terminals": "-, 2, 4"
      }
    }
  },
  {
    "id": "R-MAP-03",
    "name": "CHARM & TB Mapping: Isolated DO (Solenoid Valve / SOV / Injected Power)",
    "enabled": true,
    "kind": "charm_terminal_map",
    "severity": "hard",
    "weight": 100,
    "scope": "signal",
    "params": {
      "type_check": {
        "column": "signal_type",
        "operator": "in",
        "values": [
          "DO",
          "DOR",
          "DO-SOV",
          "DOR-SOV"
        ]
      },
      "conditions": [
        {
          "column": "instrument_type",
          "operator": "in",
          "values": [
            "XYV",
            "ZYV",
            "SOV"
          ]
        },
        {
          "column": "tag",
          "operator": "regex",
          "pattern": ".*(XYV|ZYV|SOV).*"
        },
        {
          "column": "description",
          "operator": "contains",
          "value": "solenoid"
        },
        {
          "column": "description",
          "operator": "contains",
          "value": "sov"
        },
        {
          "column": "signal_type",
          "operator": "in",
          "values": [
            "DO-SOV",
            "DOR-SOV"
          ]
        }
      ],
      "match_mode": "any",
      "hardware": {
        "charm_type": "DO 24V DC Isolated",
        "charm_part_no": "SE4302T02",
        "terminal_block": "Fused-Injected-Power Terminal Block",
        "charm_tb_part_no": "SE4502",
        "charm_tb_terminals": "-, 2, 4"
      }
    }
  },
