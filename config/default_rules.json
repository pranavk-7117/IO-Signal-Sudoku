[
  {
    "id": "R-001",
    "name": "Cable Contiguity & Monotonic Pair Order",
    "enabled": true,
    "kind": "cable_contiguous",
    "severity": "hard",
    "weight": 100,
    "scope": "cable",
    "params": {
      "enforce_order": true,
      "max_pairs_single_baseplate": 12,
      "allow_span_for_24_pair": true
    }
  },
  {
    "id": "R-002",
    "name": "A/B Redundancy CIOC Separation",
    "enabled": true,
    "kind": "separate_on",
    "severity": "hard",
    "weight": 100,
    "scope": "redundancy_group",
    "params": {
      "container_level": "cioc",
      "redundancy_key_column": "redundancy",
      "group_key_columns": [
        "logical_group",
        "loop_name",
        "unit"
      ]
    }
  },
  {
    "id": "R-003",
    "name": "Logical IO Grouping Locality",
    "enabled": true,
    "kind": "logical_group_together",
    "severity": "soft",
    "weight": 50,
    "scope": "logical_group",
    "params": {
      "target_container": "baseplate",
      "fallback_container": "cioc"
    }
  },
  {
    "id": "R-004",
    "name": "Hardware Slot Capacity Limits",
    "enabled": true,
    "kind": "capacity",
    "severity": "hard",
    "weight": 100,
    "scope": "all",
    "params": {
      "max_signals_per_charm": 1,
      "charms_per_baseplate": 12,
      "baseplates_per_cioc": 8,
      "ciocs_per_cabinet": 4
    }
  },
  {
    "id": "R-005",
    "name": "Reserved Empty Baseplates per Cabinet",
    "enabled": true,
    "kind": "spare_per_cabinet",
    "severity": "hard",
    "weight": 80,
    "scope": "cabinet",
    "params": {
      "spare_baseplate_percent": 10.0,
      "min_empty_baseplates_per_cabinet": 1
    }
  },
  {
    "id": "R-006",
    "name": "Reserve Baseplate 1 for Cabinet Diagnostics",
    "enabled": true,
    "kind": "reserve",
    "severity": "hard",
    "weight": 90,
    "scope": "cabinet",
    "params": {
      "target_cioc": "CIOC-01",
      "target_baseplate": "001-CBP-1",
      "match_condition": {
        "column": "tag",
        "operator": "contains",
        "value": "-EJA"
      },
      "fallback_condition": {
        "column": "description",
        "operator": "contains",
        "value": "Cabinet Alarm"
      }
    }
  },
  {
    "id": "R-MAP-01",
    "name": "CHARM & TB Mapping: RTD / 3-Wire Temperature",
    "enabled": true,
    "kind": "charm_terminal_map",
    "severity": "hard",
    "weight": 100,
    "scope": "signal",
    "params": {
      "conditions": [
        {
          "column": "signal_type",
          "operator": "in",
          "values": [
            "RTD",
            "AIR-RTD"
          ]
        },
        {
          "column": "electrical_spec",
          "operator": "contains",
          "value": "rtd"
        },
        {
          "column": "signal_level",
          "operator": "contains",
          "value": "3-wire"
        },
        {
          "column": "description",
          "operator": "regex",
          "pattern": "\\\\brtd\\\\b|\\\\bpt100\\\\b"
        }
      ],
      "match_mode": "any",
      "hardware": {
        "charm_type": "RTD Input Charm",
        "charm_part_no": "SE4303T03",
        "terminal_block": "Standard CHARM Terminal Block",
        "charm_tb_part_no": "SE4501",
        "charm_tb_terminals": "1, 2, 4"
      },
      "type_check": {
        "column": "signal_type",
        "operator": "in",
        "values": [
          "AI",
          "AIR",
          "RTD",
          "AIR-RTD"
        ]
      }
    }
  },
  {
    "id": "R-MAP-02",
    "name": "CHARM & TB Mapping: 4-Wire / Coriolis / External AC Power",
    "enabled": true,
    "kind": "charm_terminal_map",
    "severity": "hard",
    "weight": 100,
    "scope": "signal",
    "params": {
